# --- Database -----------------------------------------------------------
# Postgres connection string (Neon/Supabase/Vercel Postgres etc.). Vercel's
# serverless functions have no persistent/writable filesystem, so SQLite
# cannot be used once deployed — use the same hosted Postgres for local dev
# too (most providers have a free tier). Run `npx prisma migrate deploy`
# against it once (or let the `vercel-build` script do it automatically on
# each deploy) before first use.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Kakao -----------------------------------------------------------------
# REST API key (server-side only, never exposed to the client). Powers real
# company/transit lookups via Kakao Local API.
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=

# JavaScript key (safe to expose to the client — restricted by registered
# domain in the Kakao Developers console). Powers the map itself. If unset,
# the map renders a placeholder instead of crashing.
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# Also register your domain under 플랫폼 > Web 플랫폼 등록 (e.g. http://localhost:3000).
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- DART (금융감독원 OpenDART) --------------------------------------------
# Free key: https://opendart.fss.or.kr — used to pull REAL employee counts
# for listed companies only (matched against Kakao results by name). Without
# this, all "주요회사" employee counts are heuristic estimates instead — the
# app still works, just without the "실데이터" badge on any company.
DART_API_KEY=

# --- Cron auth ---------------------------------------------------------
# Shared secret required on cron routes as `Authorization: Bearer <value>`.
# Vercel Cron sends this automatically when CRON_SECRET is set as a project
# env var. Generate any long random string for local/manual use.
CRON_SECRET=

# --- MOLIT (공공데이터포털 국토교통부_아파트매매 실거래자료) -----------------
# Free key: https://www.data.go.kr — search "아파트매매 실거래자료", apply for
# "국토교통부_아파트매매 실거래자료" (getRTMSDataSvcAptTrade), usually
# auto-approved within minutes. Paste either the Encoding or Decoding key —
# the client decodes it once before use either way. Powers both
# TRANSACTION_DATA_SOURCE=real and COMPLEX_TRANSACTION_DATA_SOURCE=real.
#
# 오피스텔 데이터(추천 매물 찾기의 "건물유형: 오피스텔" 필터)를 쓰려면 같은
# 화면에서 "국토교통부_오피스텔 매매 실거래자료" (getRTMSDataSvcOffiTrade)도
# 별도로 활용신청해야 한다 — 같은 서비스키를 그대로 쓰지만 승인은 API마다
# 따로 필요하다. 승인 전에는 오피스텔 결과만 조용히 비어 있고 아파트 데이터는
# 정상 동작한다.
MOLIT_API_KEY=

# --- Data source mode (real | mock) -------------------------------------
# Defaults to mock when unset or any value other than "real". Flipping to
# "real" without the corresponding key configured fails loudly (a clear
# "*_API_KEY is not set" error) rather than silently returning nothing.
TRANSACTION_DATA_SOURCE=mock         # "real" requires MOLIT_API_KEY (above)
COMPLEX_TRANSACTION_DATA_SOURCE=mock # "real" requires MOLIT_API_KEY (above) — also geocodes complexes via Kakao for the map
ASKING_PRICE_DATA_SOURCE=mock        # no real path in this build — see realAskingPriceAdapter.ts
MIGRATION_DATA_SOURCE=mock           # "real" requires a KOSIS Open API key (not yet implemented)
