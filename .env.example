# --- Database -----------------------------------------------------------
# Local dev: SQLite file. Production (Vercel etc.): swap for a hosted
# Postgres connection string (Neon/Supabase/Vercel Postgres) — no schema
# changes required.
DATABASE_URL="file:./dev.db"

# --- Kakao -----------------------------------------------------------------
# REST API key (server-side only, never exposed to the client). Powers real
# company/transit lookups via Kakao Local API.
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=

# JavaScript key (safe to expose to the client — restricted by registered
# domain in the Kakao Developers console). Powers the map itself. If unset,
# the map renders a placeholder instead of crashing.
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# Also register your domain under 플랫폼 > Web 플랫폼 등록 (e.g. http://localhost:3000).
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- Cron auth ---------------------------------------------------------
# Shared secret required on cron routes as `Authorization: Bearer <value>`.
# Vercel Cron sends this automatically when CRON_SECRET is set as a project
# env var. Generate any long random string for local/manual use.
CRON_SECRET=

# --- Data source mode (real | mock) -------------------------------------
# Defaults to mock when unset or any value other than "real". Flipping to
# "real" without the corresponding key configured fails loudly (typed
# NotImplementedError) rather than silently returning nothing.
TRANSACTION_DATA_SOURCE=mock   # "real" requires a 공공데이터포털 실거래가 key (not yet implemented)
ASKING_PRICE_DATA_SOURCE=mock  # no real path in this build — see realAskingPriceAdapter.ts
MIGRATION_DATA_SOURCE=mock     # "real" requires a KOSIS Open API key (not yet implemented)
