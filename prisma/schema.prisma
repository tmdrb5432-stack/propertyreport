// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model District {
  id        String   @id // slug: "gwanghwamun" | "yeouido" | "gangnam" | "pangyo" | "magok"
  nameKo    String
  nameEn    String
  lat       Float
  lng       Float
  radiusM   Int
  createdAt DateTime @default(now())

  transitSnapshots            TransitSnapshot[]
  companySnapshots            CompanySnapshot[]
  transactionSnapshots        TransactionSnapshot[]
  complexTransactionSnapshots ComplexTransactionSnapshot[]
  askingPriceSnapshots        AskingPriceSnapshot[]
  migrationSnapshots          MigrationSnapshot[]
  updateLogs                  UpdateLog[]
}

model TransitSnapshot {
  id                 String   @id @default(cuid())
  districtId         String
  district           District @relation(fields: [districtId], references: [id])
  capturedAt         DateTime @default(now())
  subwayLines        Json // string[]
  subwayStationCount Int
  busStopCount       Int
  transitScore       Float // 0-100 derived 이동편의성 sub-score
  source             String // "kakao"
  raw                Json?

  @@index([districtId, capturedAt])
}

model CompanySnapshot {
  id               String   @id @default(cuid())
  districtId       String
  district         District @relation(fields: [districtId], references: [id])
  capturedAt       DateTime @default(now())
  companyCount     Int
  employeeCount    Int? // sum of per-company employeeCount (real DART where matched, else estimate)
  notableCompanies Json // { name, category, address }[]
  source           String // "kakao"
  raw              Json?

  @@index([districtId, capturedAt])
}

model TransactionSnapshot {
  id                String   @id @default(cuid())
  districtId        String
  district          District @relation(fields: [districtId], references: [id])
  capturedAt        DateTime @default(now())
  periodDate        DateTime
  avgPricePerPyeong Float?
  avgPriceTotal     Float?
  medianPriceTotal  Float?
  transactionCount  Int
  propertyType      String // "아파트" | "오피스텔" ...
  source            String // "mock" | "molit"
  raw               Json?

  @@unique([districtId, propertyType, periodDate])
  @@index([districtId, capturedAt])
}

model ComplexTransactionSnapshot {
  id                String   @id @default(cuid())
  districtId        String
  district          District @relation(fields: [districtId], references: [id])
  capturedAt        DateTime @default(now())
  periodDate        DateTime
  complexName       String // 아파트 단지명 — free-text identity, matches MOLIT's 아파트명 field
  avgPricePerPyeong Float?
  avgPriceTotal     Float?
  medianPriceTotal  Float?
  transactionCount  Int
  propertyType      String // "아파트"
  source            String // "mock" | "molit"
  raw               Json?

  @@unique([districtId, complexName, propertyType, periodDate])
  @@index([districtId, capturedAt])
}

model AskingPriceSnapshot {
  id                      String   @id @default(cuid())
  districtId              String
  district                District @relation(fields: [districtId], references: [id])
  capturedAt              DateTime @default(now())
  periodDate              DateTime
  avgAskingPricePerPyeong Float?
  avgAskingPriceTotal     Float?
  listingCount            Int
  propertyType            String
  source                  String // "mock"
  raw                     Json?

  @@unique([districtId, propertyType, periodDate])
  @@index([districtId, capturedAt])
}

model MigrationSnapshot {
  id           String   @id @default(cuid())
  districtId   String
  district     District @relation(fields: [districtId], references: [id])
  capturedAt   DateTime @default(now())
  periodMonth  String // "2026-07"
  inMigration  Int
  outMigration Int
  netMigration Int
  source       String // "mock" | "kosis"
  raw          Json?

  @@unique([districtId, periodMonth])
  @@index([districtId, capturedAt])
}

model UpdateLog {
  id         String   @id @default(cuid())
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  metricType String // "transit" | "company" | "transaction" | "asking" | "migration"
  status     String // "success" | "error"
  message    String?
  ranAt      DateTime @default(now())

  @@index([districtId, metricType, ranAt])
}

// Listed-company corp codes from OpenDART's corpCode.xml master list, filtered
// to entries that have a stock code (상장사만) — unlisted companies have no
// public employee-status disclosure via OpenDART, so they are never stored
// here and fall back to a heuristic estimate at query time instead.
model DartCorpCode {
  corpCode   String  @id // DART 고유번호 (8자리) — NOT the stock ticker
  corpName   String
  stockCode  String?
  modifyDate String?

  @@index([corpName])
}

// Read-through cache for OpenDART's 직원현황(empSttus) API so a company's
// employee count is fetched from DART at most once per cache window instead
// of on every cron run.
model DartEmployeeCache {
  corpCode      String   @id
  employeeCount Int?
  bsnsYear      String
  reprtCode     String
  fetchedAt     DateTime @default(now())
}
